# Application
APP_NAME=network-operations-api
APP_VERSION=1.0.0
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# SSH / CLI connectivity (seconds)
NETWORK_SSH_TIMEOUT=30
NETWORK_CONNECTION_TIMEOUT=20
NETWORK_COMMAND_TIMEOUT=60
NETWORK_CONNECTION_RETRIES=1

# Thread pool for blocking Netmiko operations
NETWORK_MAX_WORKERS=16

# Meraki Dashboard API
MERAKI_API_BASE_URL=https://api.meraki.com/api/v1
MERAKI_API_TIMEOUT=30
MERAKI_MAX_RETRIES=3

# Optional Redis cache (leave empty to disable; architecture is cache-ready)
REDIS_URL=

# Optional inventory / secret backends (stubs; request body is used by default)
INVENTORY_BACKEND=request
SECRET_BACKEND=request

# CORS (comma-separated origins; empty disables CORS middleware)
CORS_ALLOW_ORIGINS=
